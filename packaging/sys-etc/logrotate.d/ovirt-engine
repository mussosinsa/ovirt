"/usr/share/ovirt-engine/var/log/ovirt-engine/engine.log" "/usr/share/ovirt-engine/var/log/ovirt-engine/server.log" "/usr/share/ovirt-engine/var/log/ovirt-engine/ui.log" {
	daily
	minsize 10M
	missingok
	copytruncate
	rotate 20
	compress
}

# ovirt-host-mgmt-ansible-[0-9]*.log matches host update logs. [0-9] matches timestamp, whereas in check-for-updates
# logs an additional 'check' comes before the timestamp
# using ctime so that files will be removed 30 days from when their metadata was changed
"/usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ovirt-host-deploy*.log" "/usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ovirt-enroll-certs*.log"
"/usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ovirt-host-mgmt-ansible-[0-9]*.log" "/usr/share/ovirt-engine/var/log/ovirt-engine/ova/*.log" "/usr/share/ovirt-engine/var/log/ovirt-engine/db-manual/*.log" {
	monthly
	missingok
	compress
	nocreate
	rotate 1
	sharedscripts
	postrotate
	    /usr/bin/find /usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ -name "ovirt-host-deploy*.log.*" -type f -ctime +30 -delete
	    /usr/bin/find /usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ -name "ovirt-enroll-certs*.log.*" -type f -ctime +30 -delete
	    /usr/bin/find /usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ -name "ovirt-host-mgmt-ansible-[0-9]*.log.*" -type f -ctime +30 -delete
	    /usr/bin/find /usr/share/ovirt-engine/var/log/ovirt-engine/ova/ -name "ovirt*.log.*" -type f -ctime +30 -delete
	endscript
}

"/usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ovirt-host-mgmt-ansible-check*.log" "/usr/share/ovirt-engine/var/log/ovirt-engine/dump/*.hprof"  {
