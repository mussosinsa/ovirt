	rotate 1
	sharedscripts
	postrotate
	    /usr/bin/find /usr/share/ovirt-engine/var/log/ovirt-engine/host-deploy/ -name "ovirt-host-mgmt-ansible-check*.log.*" -type f -mtime +1 -delete
	endscript
}

