[Unit]
Description=oVirt Engine websockets proxy
After=network.target

[Service]
Type=notify
User=ovirt
Group=ovirt
LimitNOFILE=65535
LimitNPROC=2048
ExecStart=/usr/share/ovirt-engine/share/ovirt-engine/services/ovirt-websocket-proxy/ovirt-websocket-proxy.py --systemd=notify $EXTRA_ARGS start
EnvironmentFile=-/etc/sysconfig/ovirt-websocket-proxy

[Install]
WantedBy=multi-user.target
